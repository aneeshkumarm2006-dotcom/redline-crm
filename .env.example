# MongoDB Atlas connection string; URL-encode password characters.
MONGODB_URI=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Add a Resend API key when enabling email delivery.
RESEND_API_KEY=
APP_URL=http://localhost:3000
# Optional: console (capture only), resend or smtp (e.g. Gmail app password). Defaults to console in dev, resend in production.
# Live delivery also requires Settings.emailFrom to be a Resend-verified sender.
EMAIL_PROVIDER=
# Protects /api/cron (scheduled reminders). Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
# Optional: minutes between in-process reminder runs (default 15 in development, off in production where /api/cron runs). 0 disables.
AUTOMATION_INTERVAL_MINUTES=
# SMTP delivery when EMAIL_PROVIDER=smtp. Gmail: smtp.gmail.com / 465, the account address and a 16-character app password.
# Emails send as SMTP_FROM (or SMTP_USER) with the Settings company name as the display name.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional: Reply-To for every email (e.g. the dealership's inbox).
EMAIL_REPLY_TO=
# Virtual assistant (Claude) that answers customer emails. Server-only; never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Optional: Claude model for the assistant (default claude-sonnet-5-5).
ASSISTANT_MODEL=
# Reply inbox the assistant reads over IMAP. Defaults to Gmail (imap.gmail.com:993) with SMTP_USER / SMTP_PASS.
# Gmail: enable IMAP in Gmail settings; the same 16-character app password works. ASSISTANT_INBOX=off disables reading.
ASSISTANT_IMAP_HOST=
ASSISTANT_IMAP_PORT=
ASSISTANT_IMAP_USER=
ASSISTANT_IMAP_PASS=
ASSISTANT_INBOX=
# Optional: seconds between inbox checks on a long-running server (default 60 in development, off in production,
# where a scheduler calls /api/assistant/poll with "Authorization: Bearer <CRON_SECRET>"). 0 disables.
ASSISTANT_POLL_SECONDS=
# Optional: protects /api/assistant/inbound for push-style inbound email providers ("Authorization: Bearer <secret>").
ASSISTANT_INBOUND_SECRET=
