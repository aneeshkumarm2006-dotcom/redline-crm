# MongoDB Atlas connection string; URL-encode password characters.
MONGODB_URI=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Add a Resend API key when enabling email delivery.
RESEND_API_KEY=
APP_URL=http://localhost:3000
# Optional: console (capture only) or resend. Defaults to console in dev, resend in production.
# Live delivery also requires Settings.emailFrom to be a Resend-verified sender.
EMAIL_PROVIDER=
